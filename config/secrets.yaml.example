# ESPHome 密钥模板
# 复制为 secrets.yaml 后填入真实值。该文件已在 .gitignore 中，不要提交。
# 所有值都通过 esp32.yaml 里的 !secret 引用，仓库内不留任何明文凭据。

wifi_ssid: "你的 WiFi 名称"
wifi_password: "你的 WiFi 密码"
wifi_ap_password: "配网热点密码"

# ESP32 自带管理后台（web_server v3，digest 认证）
web_username: "admin"
web_password: "改成强密码"

# MQTT broker（与 Home Assistant 同机的 mosquitto）
mqtt_broker: "192.168.1.10"

# broker 启用认证时，取消 esp32.yaml 中 mqtt: 下两行的注释并填值
# mqtt_username: "mqtt-user"
# mqtt_password: "mqtt-pass"
